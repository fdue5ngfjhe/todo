# ==========================================
# .gitignore (Root)
# ==========================================

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ---------- Environment Variables ----------
# هرگز فایل‌های env را کامیت نکنید
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ---------- Build & Dist ----------
dist/
build/
out/
.next/
next-env.d.ts
*.tsbuildinfo

# ---------- Prisma ----------
# دیتابیس لوکال (اگر از SQLite یا فایل استفاده کردید)
*.db
*.db-journal
*.sqlite
*.sqlite3

# پوشه migrations را کامیت کنید (لازم است)
# اما فایل‌های موقت Prisma را نه:
backend/prisma/*.log

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------- Testing / Coverage ----------
coverage/
.nyc_output/

# ---------- Cache ----------
.cache/
.parcel-cache/
.turbo/
.eslintcache

# ---------- Misc ----------
*.pem
.pids