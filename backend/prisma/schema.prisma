generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  incomplete
  in_progress
  completed
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(incomplete)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("tasks")
}